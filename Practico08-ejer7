#include <iostream>
#include <string>
using namespace std;

// Prototipos
void leer(int &numero);
string aLetras(int numero);

int main() {
    int numero;

    leer(numero);

    cout << "Numero escrito en letras: ";
    cout << aLetras(numero) << endl;

    return 0;
}

void leer(int &numero) {
    do {
        cout << "Ingrese un numero entre 0 y 20: ";
        cin >> numero;
    } while (numero < 0 || numero > 20);
}

