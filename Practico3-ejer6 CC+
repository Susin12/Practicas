#include <iostream>
using namespace std;

int main() {

    double C, F, K, Ra;

    cout << "Ingrese la temperatura en Celsius: ";
    cin >> C;

    F = (C * 9 / 5) + 32;
    K = C + 273.15;
    Ra = (C + 273.15) * 9 / 5;

    cout << "Fahrenheit: " << F << endl;
    cout << "Kelvin: " << K << endl;
    cout << "Rankine: " << Ra << endl;

    return 0;
}
