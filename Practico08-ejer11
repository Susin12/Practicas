#include <iostream>
using namespace std;

const int MAX = 100;

// Prototipos
void leer(double v[], int &n);
void contar(const double v[], int n,
            int &positivos, int &negativos, int &ceros);
void mostrar(const double v[], int n);

int main() {
    double v[MAX];
    int n, positivos, negativos, ceros;

    leer(v, n);

    contar(v, n, positivos, negativos, ceros);

    cout << "Vector: ";
    mostrar(v, n);

    cout << "Cantidad de positivos: " << positivos << endl;
    cout << "Cantidad de negativos: " << negativos << endl;
    cout << "Cantidad de ceros: " << ceros << endl;

    return 0;
}

void leer(double v[], int &n) {
    do {
        cout << "Cantidad de elementos: ";
        cin >> n;
    } while (n < 1 || n > MAX);

    for (int i = 0; i < n; i++) {
        cout << "Ingrese un numero: ";
        cin >> v[i];
    }
}

void contar(const double v[], int n,
            int &positivos, int &negativos, int &ceros) {

    positivos = 0;
    negativos = 0;
    ceros = 0;

    for (int i = 0; i < n; i++) {
        if (v[i] > 0) {
            positivos++;
        } else if (v[i] < 0) {
            negativos++;
        } else {
            ceros++;
        }
    }
}

void mostrar(const double v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }

    cout << endl;
}
