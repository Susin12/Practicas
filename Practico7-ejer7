#include <iostream>
using namespace std;

// Prototipo
long long FAC(int n);

int main() {
    int n, r;
    double C;

    cout << "Ingrese n: ";
    cin >> n;

    cout << "Ingrese r: ";
    cin >> r;

    if (n < 0 || r < 0 || r > n) {
        cout << "Datos incorrectos";
    } else {
        C = (double)FAC(n) / (FAC(r) * FAC(n-r));

        cout << "El combinatorio es: " << C;
    }

    return 0;
}

// Desarrollo de la funcion
long long FAC(int n) {
    long long f = 1;

    for (int i = 1; i <= n; i++) {
        f = f * i;
    }

    return f;
}
