#include <iostream>
#include <cmath>
using namespace std;

int main() {

    double a, b, c;
    double discriminante;
    double x1, x2;

    cout << "Ingresar a, b y c: ";
    cin >> a >> b >> c;

    discriminante = b * b - 4 * a * c;

    if (discriminante >= 0) {

        x1 = (-b + sqrt(discriminante)) / (2 * a);
        x2 = (-b - sqrt(discriminante)) / (2 * a);

        cout << "Solucion 1: " << x1 << endl;
        cout << "Solucion 2: " << x2 << endl;

    }
    else {

        cout << "No existen soluciones reales." << endl;

    }

    return 0;
}
