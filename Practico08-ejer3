#include <iostream>
using namespace std;

const int MAX = 100;

// Prototipos
void leer(double v[], int &n);
double calcularPromedio(const double v[], int n);
void mostrar(const double v[], int n);

int main() {
    double v[MAX];
    int n;

    leer(v, n);

    cout << "Elementos del vector: ";
    mostrar(v, n);

    cout << "Promedio: " << calcularPromedio(v, n) << endl;

    return 0;
}

void leer(double v[], int &n) {
    do {
        cout << "Ingrese la cantidad de elementos: ";
        cin >> n;
    } while (n < 1 || n > MAX);

    for (int i = 0; i < n; i++) {
        cout << "Ingrese un numero: ";
        cin >> v[i];
    }
}

double calcularPromedio(const double v[], int n) {
    double suma = 0;

    for (int i = 0; i < n; i++) {
        suma += v[i];
    }

    return suma / n;
}

void mostrar(const double v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }
    cout << endl;
}
