    cin >> ws;
    getline(cin, nombres[n]);

    do {
        cout << "Ingrese la nota (0-100): ";
        cin >> notas[n];
    } while (notas[n] < 0 || notas[n] > 100);

    n++;

    cout << "Alumno registrado correctamente.\n";
}

void listar(const string nombres[],
            const double notas[], int n) {

    if (n == 0) {
        cout << "No hay alumnos registrados.\n";
        return;
    }

    cout << "\nLISTA DE ALUMNOS\n";

    for (int i = 0; i < n; i++) {
        cout << i + 1 << ". "
             << nombres[i]
             << " - Nota: "
             << notas[i] << endl;
    }
}

void ordenarAlfabeticamente(string nombres[],
                            double notas[], int n) {

    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - 1 - i; j++) {

            if (nombres[j] > nombres[j + 1]) {

                string auxiliarNombre = nombres[j];
                nombres[j] = nombres[j + 1];
                nombres[j + 1] = auxiliarNombre;

                double auxiliarNota = notas[j];
                notas[j] = notas[j + 1];
                notas[j + 1] = auxiliarNota;
            }
        }
    }
}

void mostrarMaximos(const string nombres[],
                    const double notas[], int n) {

    if (n == 0) {
        cout << "No hay alumnos registrados.\n";
        return;
    }

    double mayor = notas[0];

    for (int i = 1; i < n; i++) {
        if (notas[i] > mayor) {
            mayor = notas[i];
        }
    }

    cout << "Nota mas alta: " << mayor << endl;
    cout << "Alumno(s) con la nota mas alta:\n";

    for (int i = 0; i < n; i++) {
        if (notas[i] == mayor) {
            cout << nombres[i] << endl;
        }
    }
}

double promedio(const double notas[], int n) {

    double suma = 0;

    for (int i = 0; i < n; i++) {
        suma += notas[i];
    }

    return suma / n;
}
