#include <iostream>
#include <string>
using namespace std;

const int MAX = 100;

// Prototipos
int leerOpcion();

void registrar(string nombres[], double notas[], int &n);

void listar(const string nombres[],
            const double notas[], int n);

void ordenarAlfabeticamente(string nombres[],
                            double notas[], int n);

void mostrarMaximos(const string nombres[],
                    const double notas[], int n);

double promedio(const double notas[], int n);

int main() {
    string nombres[MAX];
    double notas[MAX];

    int n = 0;
    int opcion;

    do {
        cout << "\n===== MENU DE GESTION DE ALUMNOS =====\n";
        cout << "1. Registrar alumno y nota\n";
        cout << "2. Listar alumnos\n";
        cout << "3. Ordenar alfabeticamente por nombre\n";
        cout << "4. Mostrar alumno(s) con nota mas alta\n";
        cout << "5. Calcular promedio de notas\n";
        cout << "6. Salir\n";

        opcion = leerOpcion();

        switch (opcion) {

            case 1:
                registrar(nombres, notas, n);
                break;

            case 2:
                listar(nombres, notas, n);
                break;

            case 3:
                ordenarAlfabeticamente(nombres, notas, n);
                cout << "Alumnos ordenados correctamente.\n";
                break;

            case 4:
                mostrarMaximos(nombres, notas, n);
                break;

            case 5:
                if (n > 0) {
                    cout << "Promedio de notas: "
                         << promedio(notas, n) << endl;
                } else {
                    cout << "No hay alumnos registrados.\n";
                }
                break;

            case 6:
                cout << "Saliendo del programa...\n";
                break;

            default:
                cout << "Opcion incorrecta.\n";
        }

    } while (opcion != 6);

    return 0;
}

int leerOpcion() {
    int opcion;

    cout << "Seleccione una opcion: ";
    cin >> opcion;

    return opcion;
}

void registrar(string nombres[], double notas[], int &n) {

    if (n >= MAX) {
        cout << "Se alcanzo la capacidad maxima.\n";
        return;
    }

