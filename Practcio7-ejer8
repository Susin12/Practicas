#include <iostream>
#include <cmath>
using namespace std;

// Prototipo
void CUADRATICA(double a, double b, double c);

int main() {
    double a, b, c;

    cout << "Ingrese a: ";
    cin >> a;

    cout << "Ingrese b: ";
    cin >> b;

    cout << "Ingrese c: ";
    cin >> c;

    CUADRATICA(a, b, c);

    return 0;
}

// Desarrollo de la funcion
void CUADRATICA(double a, double b, double c) {
    double D, x1, x2;

    if (a == 0) {
        cout << "No es ecuacion cuadratica";
    } else {
        D = b*b - 4*a*c;

        if (D > 0) {
            x1 = (-b + sqrt(D)) / (2*a);
            x2 = (-b - sqrt(D)) / (2*a);

            cout << "Dos raices reales: " << x1 << " y " << x2;
        }
        else if (D == 0) {
            x1 = -b / (2*a);

            cout << "Raiz doble: " << x1;
        }
        else {
            cout << "Tiene dos raices complejas";
        }
    }
}
