#include <iostream>
using namespace std;

const int MAX = 100;

// Prototipos
void leer(double v[], int &n);
void ordenarBurbuja(double v[], int n);
void mostrar(const double v[], int n);

int main() {
    double v[MAX];
    int n;

    leer(v, n);

    cout << "Vector original: ";
    mostrar(v, n);

    ordenarBurbuja(v, n);

    cout << "Vector ordenado: ";
    mostrar(v, n);

    return 0;
}

void leer(double v[], int &n) {
    do {
        cout << "Cantidad de elementos: ";
        cin >> n;
    } while (n < 1 || n > MAX);

    for (int i = 0; i < n; i++) {
        cout << "Ingrese un numero: ";
        cin >> v[i];
    }
}

void ordenarBurbuja(double v[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - 1 - i; j++) {

            if (v[j] > v[j + 1]) {
                double auxiliar = v[j];

                v[j] = v[j + 1];

                v[j + 1] = auxiliar;
            }
        }
    }
}

void mostrar(const double v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }

    cout << endl;
}
