#include <iostream>
using namespace std;

int main()
{
    //declaracion de variables 
    int cantidad;
    double precio;
    double total;
    
    //precio del cuaderno
    precio=12;
    
    //entrada de datos
    cout<< "ingrese la cantidad de cuadernos;";
    cin >> cantidad;
    
    //proceso
    total= cantidad*precio;
    
    //salida de datos 
    cout << "el total a pagar es; " << total << "Bs" << endl;
    return 0;
}
