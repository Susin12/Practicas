#include <iostream>
using namespace std;

void leerFecha(int &dia, int &mes, int &anio) {
    cout << "Ingrese dia, mes y anio: ";
    cin >> dia >> mes >> anio;
}

int calcularEstacion(int dia, int mes) {
    if (mes == 12 && dia >= 21)
        return 1;
    else if (mes == 1 || mes == 2 ||
             (mes == 3 && dia < 21))
        return 1;
    else if (mes == 3 || mes == 4 || mes == 5 ||
             (mes == 6 && dia < 21))
        return 2;
    else if (mes == 6 || mes == 7 || mes == 8 ||
             (mes == 9 && dia < 21))
        return 3;
    else
        return 4;
}

void mostrarEstacion(int estacion) {
    if (estacion == 1)
        cout << "Verano" << endl;
    else if (estacion == 2)
        cout << "Otono" << endl;
    else if (estacion == 3)
        cout << "Invierno" << endl;
    else
        cout << "Primavera" << endl;
}

int main() {
    int dia, mes, anio, estacion;

    leerFecha(dia, mes, anio);
    estacion = calcularEstacion(dia, mes);
    mostrarEstacion(estacion);

    return 0;
}
