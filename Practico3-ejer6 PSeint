Algoritmo Temperatura
	
    Definir C, F, K, Ra Como Real
	
    Escribir "Ingrese la temperatura en Celsius: "
    Leer C
	
    F <- (C * 9 / 5) + 32
    K <- C + 273.15
    Ra <- (C + 273.15) * 9 / 5
	
    Escribir "Fahrenheit: ", F
    Escribir "Kelvin: ", K
    Escribir "Rankine: ", Ra
	
FinAlgoritmo
