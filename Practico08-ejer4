#include <iostream>
using namespace std;

const int MAX = 100;

// Prototipos
void leer(int v[], int &n);
void invertirEnOtro(const int a[], int b[], int n);
void mostrar(const int v[], int n);

int main() {
    int a[MAX], b[MAX], n;

    leer(a, n);

    invertirEnOtro(a, b, n);

    cout << "Vector A original: ";
    mostrar(a, n);

    cout << "Vector B invertido: ";
    mostrar(b, n);

    return 0;
}

void leer(int v[], int &n) {
    do {
        cout << "Cantidad de elementos: ";
        cin >> n;
    } while (n < 1 || n > MAX);

    for (int i = 0; i < n; i++) {
        cout << "Ingrese un numero: ";
        cin >> v[i];
    }
}

void invertirEnOtro(const int a[], int b[], int n) {
    for (int i = 0; i < n; i++) {
        b[i] = a[n - 1 - i];
    }
}

void mostrar(const int v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }
    cout << endl;
}
