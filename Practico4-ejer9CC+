#include <iostream>
#include <cmath>
using namespace std;

int main() {
    int n;
    double X, suma = 0, factorial = 1;

    cout << "Ingrese X: ";
    cin >> X;

    cout << "Ingrese n: ";
    cin >> n;

    for (int i = 1; i <= n; i++) {
        factorial *= i;

        if (i % 2 == 1)
            suma += pow(X, i) / factorial;
        else
            suma -= pow(X, i) / factorial;
    }

    cout << "S = " << suma << endl;

    return 0;
}
