#include <iostream>
using namespace std;

const int MAX = 93;

// Prototipos
void leer(int &n);

void generarFibonacci(unsigned long long f[], int n);

void mostrar(const unsigned long long f[], int n);

int main() {
    int n;
    unsigned long long f[MAX];

    leer(n);

    generarFibonacci(f, n);

    cout << "Serie de Fibonacci:\n";

    mostrar(f, n);

    return 0;
}

void leer(int &n) {
    do {
        cout << "Ingrese la cantidad de terminos (1-93): ";
        cin >> n;
    } while (n < 1 || n > MAX);
}

void generarFibonacci(unsigned long long f[], int n) {

    f[0] = 0;

    if (n > 1) {
        f[1] = 1;
    }

    for (int i = 2; i < n; i++) {
        f[i] = f[i - 1] + f[i - 2];
    }
}

void mostrar(const unsigned long long f[], int n) {

    for (int i = 0; i < n; i++) {
        cout << f[i] << " ";
    }

    cout << endl;
}
