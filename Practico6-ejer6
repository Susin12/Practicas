#include <iostream>
#include <cmath>
using namespace std;

void leerCoeficientes(double &a, double &b, double &c) {
    cout << "Ingrese a, b y c: ";
    cin >> a >> b >> c;
}

void calcular(double a, double b, double c) {
    double d, x1, x2;

    if (a == 0) {
        if (b != 0) {
            cout << "Ecuacion lineal." << endl;
            cout << "x = " << -c / b << endl;
        } else if (c == 0) {
            cout << "Infinitas soluciones." << endl;
        } else {
            cout << "No tiene solucion." << endl;
        }
    } else {
        d = b * b - 4 * a * c;

        if (d > 0) {
            x1 = (-b + sqrt(d)) / (2 * a);
            x2 = (-b - sqrt(d)) / (2 * a);
            cout << "Dos soluciones reales: "
                 << x1 << " y " << x2 << endl;
        } else if (d == 0) {
            x1 = -b / (2 * a);
            cout << "Una solucion real: " << x1 << endl;
        } else {
            cout << "No tiene soluciones reales." << endl;
        }
    }
}

int main() {
    double a, b, c;

    leerCoeficientes(a, b, c);
    calcular(a, b, c);

    return 0;
}c
