#include <iostream>
using namespace std;

int leerOpcion() {
    int opcion;
    cout << "1. Cuadrado" << endl;
    cout << "2. Circulo" << endl;
    cout << "3. Triangulo" << endl;
    cout << "Seleccione una opcion: ";
    cin >> opcion;
    return opcion;
}

double calcularArea(int opcion) {
    double lado, radio, base, altura;
    const double PI = 3.1416;

    if (opcion == 1) {
        cout << "Ingrese el lado: ";
        cin >> lado;
        return lado * lado;
    } else if (opcion == 2) {
        cout << "Ingrese el radio: ";
        cin >> radio;
        return PI * radio * radio;
    } else if (opcion == 3) {
        cout << "Ingrese la base y altura: ";
        cin >> base >> altura;
        return (base * altura) / 2;
    } else {
        return -1;
    }
}

void mostrarArea(double area) {
    if (area < 0)
        cout << "Opcion no valida." << endl;
    else
        cout << "El area es: " << area << endl;
}

int main() {
    int opcion;
    double area;

    opcion = leerOpcion();
    area = calcularArea(opcion);
    mostrarArea(area);

    return 0;
}
