#include <iostream>
using namespace std;

const int MAX = 100;

// Prototipos
void leer(double v[], int &n);
double mayorDiferencia(const double v[], int n, int &pos);
void mostrar(const double v[], int n);

int main() {
    double v[MAX];
    int n, pos;

    leer(v, n);

    double diferencia = mayorDiferencia(v, n, pos);

    cout << "Vector: ";
    mostrar(v, n);

    cout << "Mayor diferencia: " << diferencia << endl;

    cout << "Elementos que producen la diferencia: ";
    cout << v[pos] << " y " << v[pos + 1] << endl;

    return 0;
}

void leer(double v[], int &n) {
    do {
        cout << "Cantidad de elementos (minimo 2): ";
        cin >> n;
    } while (n < 2 || n > MAX);

    for (int i = 0; i < n; i++) {
        cout << "Ingrese un numero: ";
        cin >> v[i];
    }
}

double mayorDiferencia(const double v[], int n, int &pos) {
    double mayor = v[1] - v[0];

    if (mayor < 0) {
        mayor = -mayor;
    }

    pos = 0;

    for (int i = 1; i < n - 1; i++) {
        double diferencia = v[i + 1] - v[i];

        if (diferencia < 0) {
            diferencia = -diferencia;
        }

        if (diferencia > mayor) {
            mayor = diferencia;
            pos = i;
        }
    }

    return mayor;
}

void mostrar(const double v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }

    cout << endl;
}
