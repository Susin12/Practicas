#include <iostream>
using namespace std;

int main() {

    int dia1, mes1, dia2, mes2;
    int fecha1, fecha2, diferencia;
    int meses, dias;

    cout << "Ingrese dia y mes de la fecha inicial: ";
    cin >> dia1 >> mes1;

    cout << "Ingrese dia y mes de la fecha final: ";
    cin >> dia2 >> mes2;

    fecha1 = mes1 * 30 + dia1;
    fecha2 = mes2 * 30 + dia2;

    diferencia = fecha2 - fecha1;

    if (diferencia < 0) {
        diferencia = diferencia * (-1);
    }

    meses = diferencia / 30;
    dias = diferencia % 30;

    cout << "Diferencia: " << meses
         << " meses " << dias << " dias" << endl;

    return 0;
}
