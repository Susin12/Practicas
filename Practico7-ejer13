#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

// Prototipo
double REDONDEAR(double R, int n);

int main() {
    double R;
    int n;

    cout << "Ingrese un numero: ";
    cin >> R;

    cout << "Ingrese cantidad de decimales: ";
    cin >> n;

    if (n < 0) {
        cout << "Cantidad incorrecta";
    } else {
        cout << fixed << setprecision(n);
        cout << "Numero redondeado: " << REDONDEAR(R, n);
    }

    return 0;
}

// Desarrollo de la funcion
double REDONDEAR(double R, int n) {
    double factor = pow(10, n);

    return round(R * factor) / factor;
}
