#include <iostream>
using namespace std;

int main() {
    int n;
    long long f0 = 1, f1 = 1, f;

    cout << "Ingrese n: ";
    cin >> n;

    if (n == 0) {
        f = f0;
    }
    else if (n == 1) {
        f = f1;
    }
    else {
        for (int i = 2; i <= n; i++) {
            f = f0 + f1;
            f0 = f1;
            f1 = f;
        }
    }

    cout << "Fibonacci(" << n << ") = " << f << endl;

    return 0;
}
