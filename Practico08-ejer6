#include <iostream>
using namespace std;

const int MAX = 100;

// Prototipos
void leer(double a[], int &n);
int calcularPromedios(const double a[], int n, double p[]);
void mostrar(const double v[], int n);

int main() {
    double a[MAX], p[MAX];
    int n, cantidad;

    leer(a, n);

    cantidad = calcularPromedios(a, n, p);

    cout << "Vector original: ";
    mostrar(a, n);

    cout << "Promedios consecutivos: ";
    mostrar(p, cantidad);

    return 0;
}

void leer(double a[], int &n) {
    do {
        cout << "Cantidad de elementos (minimo 3): ";
        cin >> n;
    } while (n < 3 || n > MAX);

    for (int i = 0; i < n; i++) {
        cout << "Ingrese A[" << i << "]: ";
        cin >> a[i];
    }
}

int calcularPromedios(const double a[], int n, double p[]) {
    for (int i = 0; i < n - 2; i++) {
        p[i] = (a[i] + a[i + 1] + a[i + 2]) / 3.0;
    }

    return n - 2;
}

void mostrar(const double v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }

    cout << endl;
}
