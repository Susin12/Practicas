#include <iostream>
#include <cmath>
using namespace std;

int main() {
    int N;
    double X, S = 0;

    cout << "Ingrese X: ";
    cin >> X;

    cout << "Ingrese N: ";
    cin >> N;

    for (int i = 1; i <= N; i++) {
        S += pow(X, i);
    }

    cout << "La suma de la serie es: " << S << endl;

    return 0;
}
