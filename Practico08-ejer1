#include <iostream>
using namespace std;

const int MAX = 100;

// Prototipos
void leer(double v[], int &n);
double buscarMaximo(const double v[], int n);
void mostrar(const double v[], int n);

int main() {
    double v[MAX];
    int n;

    leer(v, n);

    cout << "Vector: ";
    mostrar(v, n);

    cout << "Valor maximo: " << buscarMaximo(v, n) << endl;

    return 0;
}

// Funcion para leer los datos
void leer(double v[], int &n) {
    do {
        cout << "Cantidad de elementos (1-100): ";
        cin >> n;
    } while (n < 1 || n > MAX);

    for (int i = 0; i < n; i++) {
        cout << "Ingrese el elemento " << i + 1 << ": ";
        cin >> v[i];
    }
}

// Funcion para buscar el maximo
double buscarMaximo(const double v[], int n) {
    double mayor = v[0];

    for (int i = 1; i < n; i++) {
        if (v[i] > mayor) {
            mayor = v[i];
        }
    }

    return mayor;
}

// Funcion para mostrar el vector
void mostrar(const double v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }
    cout << endl;
}
